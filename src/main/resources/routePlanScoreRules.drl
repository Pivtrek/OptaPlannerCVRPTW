package com.example.routeplaner.optimization.rules;

import com.example.routeplaner.model.Vehicle;
import com.example.routeplaner.model.Warehouse;
import com.example.routeplaner.optimization.model.RoutePlan;

rule "Minimize total distance"
    when
        // Dopasowanie encji Vehicle i Warehouse
        $vehicle : Vehicle()
        $warehouse : Warehouse()
    then
        // Logika punktacji
        //scoreHolder.addSoftConstraintMatch(kcontext, -distance($vehicle, $warehouse));
end

function double distance(Vehicle vehicle, Warehouse warehouse) {
    // Przykład obliczania odległości między pojazdem a magazynem
    double dx = vehicle.getGarage().getLatitude() - warehouse.getLatitude();
    double dy = vehicle.getGarage().getLongitude() - warehouse.getLongitude();
    return Math.sqrt(dx * dx + dy * dy);
}